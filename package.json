{
  "name": "stakinghub-qa",
  "version": "1.0.0",
  "description": "Cypress E2E test suite for the StakingHUB PHP platform",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:auth": "cypress run --spec \"cypress/e2e/auth/**/*.cy.js\"",
    "cy:run:admin": "cypress run --spec \"cypress/e2e/admin/**/*.cy.js\""
  },
  "devDependencies": {
    "cypress": "^13.15.0"
  }
}
